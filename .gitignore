# Project runtime artefacts
# ---------------------------------------------------------------------------
# Local log and scratch output
*.log
streamlit.log
.tmp_schema/
tmp/
scratch/

# Locally cached upstream data. The dashboard re-fetches on demand; committing
# cache blobs would bloat the repo and go stale silently.
data/cache/

# Streamlit's local secrets file must never be committed
.streamlit/secrets.toml

