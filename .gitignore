!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# AI assistant context and agent workspace
#
# These directories hold local prompts, instructions, agent definitions and
# chat/tool state that are specific to one machine and one assistant session.
# They are not part of the application and must not be published.
# ---------------------------------------------------------------------------
